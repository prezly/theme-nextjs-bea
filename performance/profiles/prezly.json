{
    "name": "Prezly website",
    "baseUrl": "https://www.prezly.com",
    "location": "set BENCHMARK_LOCATION",
    "routes": ["/", "/pricing/", "/academy/"],
    "crawl": {
        "enabled": false,
        "maxPages": 10,
        "routeCount": 0,
        "seed": 24250
    },
    "http": {
        "coldRepeats": 1,
        "warmupRepeats": 1,
        "warmRepeats": 3,
        "requestsPerSecond": 1,
        "timeoutSeconds": 30
    },
    "browser": {
        "repeats": 1,
        "requestsPerSecond": 0.2,
        "timeoutMs": 45000
    },
    "thresholds": {
        "warmTtfbP95Percent": 20,
        "responseBytesMedianPercent": 10,
        "browserNavigationP95Percent": 20
    },
    "instrumentation": {
        "replicaHeaders": ["x-envoy-upstream-service-time", "x-served-by"]
    }
}
