varnishtest "Bea production cache policy"

server s1 {
    rxreq
    expect req.url == "/cacheable"
    expect req.http.Cookie == <undef>
    txresp -status 200 -hdr "Cache-Control: public, max-age=60" -body "cached"

    rxreq
    expect req.url == "/private"
    txresp -status 200 -hdr "Cache-Control: private, no-cache, no-store" -body "private-one"

    rxreq
    expect req.url == "/private"
    txresp -status 200 -hdr "Cache-Control: private, no-cache, no-store" -body "private-two"

    rxreq
    expect req.url == "/hosted"
    txresp -status 200 -hdr "Cache-Control: public, max-age=60" -body "first-host"

    rxreq
    expect req.url == "/hosted"
    txresp -status 200 -hdr "Cache-Control: public, max-age=60" -body "second-host"

    rxreq
    expect req.url == "/ban-me"
    txresp -status 200 -hdr "Cache-Control: public, max-age=60" -body "before-ban"

    rxreq
    expect req.url == "/ban-me"
    txresp -status 200 -hdr "Cache-Control: public, max-age=60" -body "after-ban"
} -start

varnish v1 -vcl+backend {
    include "/test/policy.vcl";
} -start

client c1 {
    txreq -url "/cacheable" -hdr "Host: first.example" -hdr "Cookie: session=one"
    rxresp
    expect resp.status == 200
    expect resp.http.X-Prezly-Cache == "Miss"
    expect resp.body == "cached"

    txreq -url "/cacheable" -hdr "Host: first.example" -hdr "Cookie: session=two"
    rxresp
    expect resp.status == 200
    expect resp.http.X-Prezly-Cache == "Hit"
    expect resp.body == "cached"
} -run

client c2 {
    txreq -url "/private" -hdr "Host: first.example"
    rxresp
    expect resp.status == 200
    expect resp.http.X-Prezly-Cache == "Miss"
    expect resp.body == "private-one"

    txreq -url "/private" -hdr "Host: first.example"
    rxresp
    expect resp.status == 200
    expect resp.http.X-Prezly-Cache == "Miss"
    expect resp.body == "private-two"
} -run

client c3 {
    txreq -url "/hosted" -hdr "Host: first.example"
    rxresp
    expect resp.http.X-Prezly-Cache == "Miss"
    expect resp.body == "first-host"

    txreq -url "/hosted" -hdr "Host: second.example"
    rxresp
    expect resp.http.X-Prezly-Cache == "Miss"
    expect resp.body == "second-host"

    txreq -url "/hosted" -hdr "Host: first.example"
    rxresp
    expect resp.http.X-Prezly-Cache == "Hit"
    expect resp.body == "first-host"
} -run

client c4 {
    txreq -url "/ban-me" -hdr "Host: first.example" -hdr "X-Newsroom-Uuid: room-one"
    rxresp
    expect resp.http.X-Prezly-Cache == "Miss"
    expect resp.body == "before-ban"

    txreq -url "/ban-me" -hdr "Host: first.example" -hdr "X-Newsroom-Uuid: room-one"
    rxresp
    expect resp.http.X-Prezly-Cache == "Hit"
    expect resp.body == "before-ban"

    txreq -req BAN -url "/" -hdr "Host: first.example" -hdr "X-Newsroom-Uuid: room-one"
    rxresp
    expect resp.status == 204

    txreq -url "/ban-me" -hdr "Host: first.example" -hdr "X-Newsroom-Uuid: room-one"
    rxresp
    expect resp.http.X-Prezly-Cache == "Miss"
    expect resp.body == "after-ban"
} -run

server s1 -wait
