#!/usr/bin/env bash

set -euo pipefail

SCRIPT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
PROJECT_ROOT=$(cd "${T3CODE_PROJECT_ROOT:-$SCRIPT_ROOT}" && pwd -P)
WORKTREE_ROOT=$(cd "${T3CODE_WORKTREE_PATH:-$SCRIPT_ROOT}" && pwd -P)

printf 'Preparing local environment files in %s.\n' "$WORKTREE_ROOT"
BEA_ENV_ROOT="$WORKTREE_ROOT" \
BEA_ENV_COPY_SOURCE="$PROJECT_ROOT" \
    "$WORKTREE_ROOT/scripts/bea-env" prepare-worktree
